# Copy to .env.docker and adjust, then:
#   docker compose --env-file .env.docker up -d --build

# --- Database ---------------------------------------------------------------
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=postgres

# --- JWT / API keys ---------------------------------------------------------
# JWT_SECRET must be at least 32 characters. ANON_KEY and SERVICE_ROLE_KEY are
# JWTs signed with that exact secret (role=anon / role=service_role).
# The defaults below are the well-known Supabase demo keys for the demo secret –
# CHANGE ALL THREE before exposing the stack to a network.
JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlLWRlbW8iLCJpYXQiOjE2NDE3NjkyMDAsImV4cCI6MTc5OTUzNTYwMH0.dc_X5iR_VP_qT0zsiyj_I_OZ2T9FtRU2BBNWN8Bu4GE
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoic2VydmljZV9yb2xlIiwiaXNzIjoic3VwYWJhc2UtZGVtbyIsImlhdCI6MTY0MTc2OTIwMCwiZXhwIjoxNzk5NTM1NjAwfQ.DaYlNEoUrrEn2Ig7tqibS-PHK5vgusbcbo7X36XVt4Q
REALTIME_SECRET_KEY_BASE=change-me-a-64-character-random-string-for-realtime-secret-base

# --- URLs / ports -----------------------------------------------------------
# Public URL of the Supabase gateway (kong) as reachable from the browser.
SUPABASE_PUBLIC_URL=http://localhost:8000
SITE_URL=http://localhost:3000
APP_PORT=3000
KONG_PORT=8000
STUDIO_PORT=8001

# --- Auth behaviour ---------------------------------------------------------
DISABLE_SIGNUP=false
MAILER_AUTOCONFIRM=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=admin@example.com
SMTP_SENDER_NAME=Kleiderverleih
